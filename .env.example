# Career Pilot Environment Variables Example
# Duplicate this file as .env and update the values as per your local MySQL configuration

SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
FLASK_ENV=development
FLASK_DEBUG=True

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=career_pilot
DB_USER=root
DB_PASSWORD=

# Optional: Set to sqlite for lightweight testing or MySQL fallback mode (mysql/sqlite)
DB_TYPE=mysql
